[Unit]
Description=Token Guardian Production Service
After=network.target

[Service]
Type=simple
User=tokenguardian
Group=tokenguardian
WorkingDirectory=/opt/tokenguardian
ExecStart=/opt/tokenguardian/venv/bin/python /opt/tokenguardian/tokenguardian.py start --live
ExecStop=/opt/tokenguardian/venv/bin/python /opt/tokenguardian/tokenguardian.py stop
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1
StartLimitIntervalSec=60
StartLimitBurst=3

[Install]
WantedBy=multi-user.target
